{
  "Name": "Just Monitor Control",
  "Version": "0.9.5.0",
  "Author": "Valiantsin Dzerakh",
  "Actions": [
    {
      "Name": "Brightness",
      "UUID": "com.valentderah.just-monitor-control.brightness",
      "Icon": "imgs/actions/list/brightness",
      "Tooltip": "Set an exact level, step it up or down, or switch between two saved states on several monitors at once.",
      "PropertyInspectorPath": "ui/inspector.html",
      "Controllers": ["Keypad"],
      "States": [{ "Image": "imgs/actions/brightness", "TitleAlignment": "bottom" }]
    },
    {
      "Name": "Input Switch",
      "UUID": "com.valentderah.just-monitor-control.input-switch",
      "Icon": "imgs/actions/list/input",
      "Tooltip": "Switch to a specific port, or between two.",
      "PropertyInspectorPath": "ui/inspector.html",
      "Controllers": ["Keypad"],
      "States": [
        { "Image": "imgs/actions/input", "TitleAlignment": "bottom" },
        { "Image": "imgs/actions/input-b", "TitleAlignment": "bottom" }
      ]
    },
    {
      "Name": "Refresh Rate Change",
      "UUID": "com.valentderah.just-monitor-control.refresh-rate",
      "Icon": "imgs/actions/list/refresh",
      "Tooltip": "Refresh rates reported by Windows, including exact modes such as 59.94 Hz.",
      "PropertyInspectorPath": "ui/inspector.html",
      "Controllers": ["Keypad"],
      "States": [{ "Image": "imgs/actions/refresh", "TitleAlignment": "bottom" }]
    },
    {
      "Name": "HDR",
      "UUID": "com.valentderah.just-monitor-control.hdr",
      "Icon": "imgs/actions/list/hdr",
      "Tooltip": "Toggle HDR on selected monitors.",
      "PropertyInspectorPath": "ui/inspector.html",
      "Controllers": ["Keypad"],
      "States": [
        { "Image": "imgs/actions/hdr-off", "TitleAlignment": "bottom" },
        { "Image": "imgs/actions/hdr", "TitleAlignment": "bottom" }
      ]
    },
    {
      "Name": "Sleep",
      "UUID": "com.valentderah.just-monitor-control.sleep",
      "Icon": "imgs/actions/list/sleep",
      "Tooltip": "Sleep selected monitors or the whole desktop, then wake them again.",
      "PropertyInspectorPath": "ui/inspector.html",
      "Controllers": ["Keypad"],
      "States": [
        { "Image": "imgs/actions/sleep", "TitleAlignment": "bottom" },
        { "Image": "imgs/actions/sleep-asleep", "TitleAlignment": "bottom" }
      ]
    },
    {
      "Name": "Raw VCP",
      "UUID": "com.valentderah.just-monitor-control.raw-vcp",
      "Icon": "imgs/actions/list/vcp",
      "Tooltip": "Send a raw DDC/CI VCP code.",
      "PropertyInspectorPath": "ui/inspector.html",
      "Controllers": ["Keypad"],
      "States": [{ "Image": "imgs/actions/vcp", "TitleAlignment": "bottom" }]
    }
  ],
  "Category": "Just Monitor Control",
  "CategoryIcon": "imgs/plugin/category-icon",
  "CodePath": "bin/plugin.exe",
  "Description": "Just set brightness, switch video input, change refresh rate, toggle HDR, or put monitors to sleep directly from Stream Deck",
  "Icon": "imgs/plugin/marketplace",
  "SDKVersion": 3,
  "Software": { "MinimumVersion": "6.9" },
  "OS": [{ "Platform": "windows", "MinimumVersion": "10" }],
  "UUID": "com.valentderah.just-monitor-control"
}
